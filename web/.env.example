# No vault address is hardcoded. The Mini App loads a circle via ?vault=0x…,
# which the bot appends per group chat. The @circlabasebot default vault is:
# 0x25Fcc446bBfb7444F0b9738423dD58713361010d
NEXT_PUBLIC_CIRCLA_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_CIRCLA_STOCK_ADDRESS=0xb20000000000000000000078ee7ce2fE4908108C
NEXT_PUBLIC_CIRCLA_ROUTER_ADDRESS=0x698Cb2b6dd822994581fEa6eA4Fc755d1363A92F
NEXT_PUBLIC_CIRCLA_AERODROME_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/circlabasebot
# NEXT_PUBLIC_TELEGRAM_APP_URL=https://circlabasebot.vercel.app/app  # Mini App URL
# WalletConnect Cloud Project ID (cloud.reown.com) - enables the in-app
# phone-wallet QR pairing option in the Mini App. Optional; the button is
# hidden when unset.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_LOOM_URL=          # demo video link for the landing page
# Base Mainnet: official base.org/stocks B20 precompiles, mainnet USDC, Aerodrome Slipstream router
