# Telegram Bot API token from @BotFather.
# NOTE: never commit a real token. Copy to .env and fill in.
TELEGRAM_BOT_TOKEN=

# Default vault for unbound groups ("Nairobi Tech Circle" on Base mainnet).
CIRCLA_VAULT_ADDRESS=0x83f550601Cc9Fc4397216bc8E3422408C285A464

# URL of the Telegram Mini App (Next.js). The bot's web_app buttons open this.
CIRCLA_TMA_URL=https://circla.example.com/app

# t.me Direct Link for the Mini App (BotFather /newapp short name). Group
# buttons append ?startapp=<vault> so the app opens in-Telegram with the right circle.
CIRCLA_TMA_DIRECT_LINK=https://t.me/circlabasebot/circlabasebot

# Optional: file path for per-chat vault mappings (defaults to bot/data/circles.json).
# CIRCLA_CIRCLES_FILE=

# Optional: Base RPC. Defaults to the public https://mainnet.base.org which is
# rate-limited; set a dedicated endpoint (Alchemy/Coinbase Developer) for production.
BASE_RPC_URL=https://mainnet.base.org

# Optional: watcher polling interval in milliseconds (default 12000).
# CIRCLA_POLL_INTERVAL_MS=12000

# Production (Render/always-on host) webhook mode. When CIRCLA_WEBHOOK_URL is
# set, the bot registers a Telegram webhook instead of long-polling. This is
# REQUIRED on hosts that sleep idle processes (e.g. Render free tier), because
# Telegram POSTs each update to the webhook URL and keeps the service awake.
# Leave unset locally to keep using long-polling (no public URL needed).
# CIRCLA_WEBHOOK_URL=https://circla-bot.onrender.com
# CIRCLA_WEBHOOK_SECRET=replace-with-a-long-random-string

# Optional: keep the Mini App title-catalog git push from running (used by the
# containerized bot to avoid committing from inside the image). Usually you do
# not need to set this; the bot auto-detects whether it is inside a git repo.
# CIRCLA_SKIP_GIT_SYNC=1